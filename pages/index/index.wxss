.game-shell,
.game-canvas {
  display: block;
  width: 100vw;
  height: 100vh;
}

.game-shell {
  position: relative;
  overflow: hidden;
  background: #092b36;
}

.share-sheet {
  position: absolute;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  box-sizing: border-box;
  background: rgba(5, 25, 34, 0.86);
}

.share-card {
  width: 100%;
  padding: 28rpx;
  box-sizing: border-box;
  text-align: center;
  background: #0c303a;
  border: 2rpx solid #739295;
  box-shadow: 10rpx 10rpx 0 #061a22;
}

.share-preview {
  width: 100%;
  height: 520rpx;
  background: #092b36;
}

.share-title {
  margin-top: 26rpx;
  color: #ffe074;
  font-size: 42rpx;
  font-weight: 800;
}

.share-copy {
  margin: 12rpx 0 26rpx;
  color: #c2d6ca;
  font-size: 26rpx;
}

.share-button,
.close-button {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 0;
  font-size: 30rpx;
  font-weight: 700;
}

.share-button {
  color: #162f35;
  background: #fbd65b;
}

.close-button {
  margin-top: 20rpx;
  color: #f2eed7;
  background: #153b43;
  border: 2rpx solid #52767a;
}
